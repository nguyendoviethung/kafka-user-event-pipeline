            "pm.collectionVariables.set('userId', json.id);",
            "pm.test('Status la ACTIVE', () => pm.expect(json.status).to.eql('ACTIVE'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"hung\",\n  \"email\": \"hung@gmail.com\",\n  \"fullName\": \"Nguyen Van Hung\",\n  \"roleId\": {{roleId}},\n  \"departmentId\": {{deptId}}\n}" },
