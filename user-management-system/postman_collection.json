{
  "info": {
    "name": "User Management System - Server A + Server B",
    "description": "Test CRUD Server A (8085) va thong ke Server B (8086) qua Kafka async event",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrlA", "value": "http://localhost:8085" },
    { "key": "baseUrlB", "value": "http://localhost:8086" },
    { "key": "orgId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "deptId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "A. Organization",
      "item": [
        {
          "name": "ORG-01 Create Organization (success)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('orgId', json.id);",
            "pm.test('Has id', () => pm.expect(json.id).to.exist);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cong ty ABC\",\n  \"description\": \"Tru so chinh\"\n}" },
            "url": "{{baseUrlA}}/api/organizations"
          }
        },
        {
          "name": "ORG-02 Create Organization (duplicate -> 409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cong ty ABC\",\n  \"description\": \"Trung ten\"\n}" },
            "url": "{{baseUrlA}}/api/organizations"
          }
        },
        {
          "name": "ORG-03 Create Organization (missing name -> 400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Thieu name\"\n}" },
            "url": "{{baseUrlA}}/api/organizations"
          }
        },
        {
          "name": "ORG-04 Get All Organizations",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrlA}}/api/organizations" }
        },
        {
          "name": "ORG-05 Get Organization By Id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrlA}}/api/organizations/{{orgId}}" }
        },
        {
          "name": "ORG-06 Get Organization Not Found -> 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrlA}}/api/organizations/999999" }
        },
        {
          "name": "ORG-07 Update Organization",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cong ty ABC Updated\",\n  \"description\": \"Da cap nhat\"\n}" },
            "url": "{{baseUrlA}}/api/organizations/{{orgId}}"
          }
        }
      ]
